# Build outputs
/output/

# Cosign signing private key for Zarf packages -- MUST NOT be committed.
# (omni/zarf/cosign.pub IS committed; only the .key is secret.)
omni/zarf/cosign.key
**/cosign.key
**/cosign.password

# Per-deployment artifacts pulled back from a running VM during local
# testing (e.g. the Root CA generated on first boot by omni-bootstrap).
# Each deployment generates its own; pinning one in the repo would be
# misleading.
/omni-lab-ca.crt
*.crt
*.pem
!omni/firewalld/*.xml
