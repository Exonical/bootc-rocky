# Layered image: takes a Rocky Linux bootc base and adds the Omni stack.
#
# Build with:
#   make base ROCKY_VERSION=10
#   make omni ROCKY_VERSION=10
#
# Or manually:
#   sudo podman build -f 10/omni/Containerfile \
#     --build-arg BASE_IMAGE=localhost/rocky-bootc:latest \
#     -t rocky-bootc-omni .
ARG BASE_IMAGE=localhost/rocky-bootc:latest
FROM ${BASE_IMAGE}

# httpd-tools -> htpasswd (used by omni-bootstrap).
# cloud-init  -> per-VM provisioning (user, SSH key, hostname, network).
# cloud-init on Rocky 10 hard-requires dhcpcd; force-remove it since
# NetworkManager in the base image already handles networking.
# Enable cloud-init by linking its target into default.target.wants (the
# RHEL/CentOS bootc idiom), then scrub /var per bootc conventions.
RUN dnf install -y --setopt=install_weak_deps=False httpd-tools cloud-init \
 && (rpm -q dhcpcd >/dev/null 2>&1 \
     && rpm -e --nodeps dhcpcd \
     && (getent passwd dhcpcd >/dev/null && userdel  dhcpcd || true) \
     && (getent group  dhcpcd >/dev/null && groupdel dhcpcd || true) \
     || true) \
 && ln -sf ../cloud-init.target \
        /usr/lib/systemd/system/default.target.wants/cloud-init.target \
 && dnf clean all \
 && rm -rf /var/cache/* /var/log/* /var/lib/{dnf,cloud,dhcpcd} /var/tmp/*

# firewalld + an "omni" service definition, pre-enabled in the public zone.
# firewall-offline-cmd edits /etc/firewalld/zones/public.xml without needing
# the daemon to be running, so the VM boots into a locked-down state with
# exactly the ports Omni needs open (+ ssh, dhcpv6-client from defaults).
COPY 10/omni/firewalld/omni.xml /usr/lib/firewalld/services/omni.xml
RUN dnf install -y --setopt=install_weak_deps=False firewalld \
 && firewall-offline-cmd --zone=public --add-service=omni \
 && systemctl enable firewalld.service \
 && dnf clean all \
 && rm -rf /var/cache/* /var/log/* /var/lib/dnf /var/tmp/*

# --- Registry bootstrap: Zot (pinned by digest) --------------------------
# Zot is the one image we cannot deliver with Zarf (Zarf mirrors INTO a
# registry; Zot IS that registry). We fetch exactly one pinned digest at
# build time into a local OCI layout, and at first boot load it into
# podman containers-storage so zot.service can start offline. Everything
# else (Omni, Dex, Talos, Cilium, ...) is delivered as cosign-signed
# Zarf packages; see 10/omni/zarf/README.md.
#
# To bump Zot: run `make zot-refresh` (prints current upstream digest for
# the ZOT_IMAGE tag), review the diff, commit the new ZOT_DIGEST.
ARG ZOT_IMAGE=ghcr.io/project-zot/zot-minimal-linux-amd64:v2.1.16
ARG ZOT_DIGEST=sha256:1330a6f5710cdbd3469faea30912615d87f5c75a4eeb6c4ea20fea815095dd09
RUN dnf install -y --setopt=install_weak_deps=False jq skopeo \
 && dnf clean all \
 && rm -rf /var/cache/* /var/log/* /var/lib/dnf /var/tmp/* \
 && zot_repo="${ZOT_IMAGE%:*}"; zot_tag="${ZOT_IMAGE##*:}"; \
    mkdir -p "/usr/share/zot-preload/$zot_repo" \
 && skopeo copy --retry-times=3 \
      "docker://$zot_repo@${ZOT_DIGEST}" \
      "oci:/usr/share/zot-preload/$zot_repo:$zot_tag" \
 && got="sha256:$(skopeo inspect --raw \
      "oci:/usr/share/zot-preload/$zot_repo:$zot_tag" | sha256sum | awk '{print $1}')" \
 && if [ "$got" != "${ZOT_DIGEST}" ]; then \
      echo "[zot-bootstrap] digest mismatch: expected ${ZOT_DIGEST}, got $got" >&2; \
      exit 4; \
    fi \
 && echo "${ZOT_IMAGE}@${ZOT_DIGEST}" > /usr/share/zot-preload/BOOTSTRAP_REF \
 && rm -rf /var/lib/containers /var/cache/* /var/log/* /var/tmp/*

# Deterministic inventory + tree hash of /usr/share/zot-preload.
COPY 10/omni/scripts/airgap-inventory.sh    /usr/libexec/airgap-inventory
RUN chmod 0755 /usr/libexec/airgap-inventory \
 && /usr/libexec/airgap-inventory

# Zot configuration + first-boot loader for the preloaded layout.
COPY 10/omni/zot/config.json /etc/zot/config.json
COPY 10/omni/containers/registries.conf.d/zot.conf \
     /etc/containers/registries.conf.d/zot.conf
COPY 10/omni/scripts/airgap-image-load.sh       /usr/libexec/airgap-image-load
COPY 10/omni/scripts/airgap-image-load.service  /usr/lib/systemd/system/airgap-image-load.service
RUN chmod 0755 /usr/libexec/airgap-image-load \
 && systemctl enable airgap-image-load.service

# --- Zarf: signed packages for everything except the Zot bootstrap ------
ARG ZARF_VERSION=v0.59.0
ARG ZARF_SHA256=
RUN curl -fsSL -o /usr/local/bin/zarf \
      "https://github.com/zarf-dev/zarf/releases/download/${ZARF_VERSION}/zarf_${ZARF_VERSION}_Linux_amd64" \
 && if [ -n "${ZARF_SHA256}" ]; then \
      echo "${ZARF_SHA256}  /usr/local/bin/zarf" | sha256sum -c -; \
    fi \
 && chmod 0755 /usr/local/bin/zarf \
 && /usr/local/bin/zarf version
COPY output/zarf/zarf-package-*.tar.zst    /usr/share/zarf/packages/
COPY 10/omni/zarf/cosign.pub                  /etc/zarf/cosign.pub
COPY 10/omni/scripts/zarf-package-publish.sh      /usr/libexec/zarf-package-publish
COPY 10/omni/scripts/zarf-package-publish.service /usr/lib/systemd/system/zarf-package-publish.service
RUN chmod 0755 /usr/libexec/zarf-package-publish \
 && systemctl enable zarf-package-publish.service

# --- Quadlets: Omni, Dex, Zot systemd container units --------------------
COPY 10/omni/quadlets/*.container /usr/share/containers/systemd/

# --- First-boot bootstrap: PKI, configs, etcd key -----------------------
COPY 10/omni/scripts/omni-bootstrap.sh      /usr/libexec/omni-bootstrap
COPY 10/omni/scripts/omni-bootstrap.service /usr/lib/systemd/system/omni-bootstrap.service
RUN chmod 0755 /usr/libexec/omni-bootstrap \
 && systemctl enable omni-bootstrap.service \
 && systemctl enable podman.socket

# Scrub /var (bootc convention: /var must be empty in the image).
RUN rm -rf /var/cache/* /var/log/* /var/lib/dnf /var/tmp/*

RUN bootc container lint --fatal-warnings
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
