[Unit]
Description=Zot OCI Container Registry (airgap image store)
Documentation=https://zotregistry.dev/
After=network-online.target airgap-image-load.service
Wants=network-online.target
Requires=airgap-image-load.service

[Container]
Image=ghcr.io/project-zot/zot-minimal-linux-amd64:v2.1.16
ContainerName=zot
PublishPort=5000:5000

Volume=/etc/zot/config.json:/etc/zot/config.json:ro,Z
Volume=/var/lib/zot:/var/lib/zot:rw,Z

Exec=serve /etc/zot/config.json

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
